@model Insurance_Management_System.ViewModels.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot Password - Insurance Management System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="card-header bg-primary text-white text-center py-4">
                        <div class="fs-1 mb-1">🔑</div>
                        <h3 class="fw-bold mb-1">Forgot Password</h3>
                        <small class="text-white-50">Insurance Management System</small>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <p class="text-muted small text-center mb-4">
                            Enter your registered email address below and we will send you a 6-digit One-Time Password (OTP) to reset your password.
                        </p>

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <form asp-action="SendOTP" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-4">
                                <label asp-for="Email" class="form-label fw-semibold">Registered Email</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="user@example.com" required autofocus />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                                <i class="bi bi-send me-1"></i> Send OTP Code
                            </button>
                        </form>

                        <hr class="my-4" />

                        <div class="text-center">
                            <a asp-action="Login" class="text-decoration-none small fw-semibold text-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>


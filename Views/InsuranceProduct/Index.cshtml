@model IEnumerable<InsuranceProduct>
@{
    ViewData["Title"] = "Insurance Products";
}

<div class="dashboard-shell">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div><p class="text-uppercase small fw-semibold text-secondary mb-1">Catalogue</p><h1 class="h2 mb-1">Insurance products</h1><p class="text-secondary mb-0">Manage the products available to customers.</p></div>
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-2"></i>Add product</a>
    </div>

    <div class="dashboard-panel">
        @if (!Model.Any())
        {
            <div class="text-center text-secondary py-5"><i class="bi bi-inbox fs-1 d-block mb-2"></i>No products found. Add the first one.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Product</th><th>Company</th><th>Type</th><th>Premium</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td><div class="fw-semibold">@product.Name</div><small class="text-secondary">@product.Detail</small></td>
                            <td>@product.Company?.Name</td><td>@product.InsuranceType?.Name</td><td>@product.BasePremium.ToString("C")</td>
                            <td><span class="badge text-bg-success">@product.Status</span></td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@product.InProId" title="Edit product"><i class="bi bi-pencil"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@model AgentDashboardViewModel
@{
    ViewData["Title"] = "Agent Dashboard";
}

<div class="dashboard-shell">
    <div class="dashboard-hero mb-4 d-flex flex-column flex-lg-row justify-content-between gap-3">
        <div>
            <p class="text-uppercase small fw-semibold mb-2 opacity-75">Agent workspace</p>
            <h1 class="display-6 fw-bold mb-2">@Model.Company.Name</h1>
            <p class="mb-0 opacity-75">Registration: @Model.Company.RegNo</p>
        </div>
        <div class="text-lg-end"><span class="badge rounded-pill text-bg-warning fs-6">@Model.Company.ApproveStatus</span><div class="small opacity-75 mt-2">Approval status</div></div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="stat-card"><span class="stat-icon"><i class="bi bi-shield-check"></i></span><div class="text-secondary small mt-3">My products</div><div class="fs-2 fw-bold">@Model.ProductCount</div></div></div>
        <div class="col-md-4"><div class="stat-card"><span class="stat-icon"><i class="bi bi-building"></i></span><div class="text-secondary small mt-3">Company email</div><div class="fw-semibold mt-2 text-break">@Model.Company.Email</div></div></div>
        <div class="col-md-4"><div class="stat-card"><span class="stat-icon"><i class="bi bi-telephone"></i></span><div class="text-secondary small mt-3">Company phone</div><div class="fw-semibold mt-2">@Model.Company.Phone</div></div></div>
    </div>

    <div class="dashboard-panel">
        <div class="d-flex justify-content-between align-items-center mb-3"><div><h2 class="h4 mb-1">Company products</h2><p class="text-secondary mb-0">Products assigned to your company.</p></div><form asp-controller="Auth" asp-action="Logout" method="post"><button class="btn btn-outline-dark btn-sm" type="submit"><i class="bi bi-box-arrow-right me-1"></i>Sign out</button></form></div>
        @if (Model.Products.Count == 0)
        {
            <div class="text-center text-secondary py-5"><i class="bi bi-inbox fs-1 d-block mb-2"></i>No products assigned yet.</div>
        }
        else
        {
            <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Product</th><th>Type</th><th>Premium</th><th>Status</th></tr></thead><tbody>
            @foreach (var product in Model.Products)
            {
                <tr><td class="fw-semibold">@product.Name</td><td>@product.InsuranceType?.Name</td><td>@product.BasePremium.ToString("C")</td><td><span class="badge text-bg-success">@product.Status</span></td></tr>
            }
            </tbody></table></div>
        }
    </div>
</div>
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-shell">
    <div class="dashboard-hero mb-4 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div>
            <p class="text-uppercase small fw-semibold mb-2 opacity-75">Operations overview</p>
            <h1 class="display-6 fw-bold mb-2">Insurance dashboard</h1>
            <p class="mb-0 opacity-75">Manage your catalogue and monitor the system at a glance.</p>
        </div>
        <a class="btn btn-light fw-semibold" asp-controller="InsuranceProduct" asp-action="Create">
            <i class="bi bi-plus-lg me-2"></i>Add product
        </a>
    </div>

    <div class="dashboard-panel mb-4 border-warning">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div><h2 class="h4 mb-1"><i class="bi bi-bell text-warning me-2"></i>Company approvals <span class="badge text-bg-warning ms-1">@Model.PendingCompanyCount</span></h2><p class="text-secondary mb-0">New agent registrations waiting for review.</p></div>
        </div>
        @if (Model.PendingCompanies.Count == 0)
        {
            <div class="text-secondary py-3">No company registrations are waiting for approval.</div>
        }
        else
        {
            <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Company</th><th>Contact</th><th>Registered</th><th class="text-end">Decision</th></tr></thead><tbody>
            @foreach (var company in Model.PendingCompanies)
            {
                <tr><td><div class="fw-semibold">@company.Name</div><small class="text-secondary">@company.RegNo</small></td><td><div>@company.Email</div><small class="text-secondary">@company.Phone</small></td><td>@company.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td class="text-end"><div class="d-inline-flex gap-2"><form asp-action="ApproveCompany" method="post"><input type="hidden" name="id" value="@company.CompanyId" />@Html.AntiForgeryToken()<button class="btn btn-sm btn-success" type="submit"><i class="bi bi-check-lg me-1"></i>Approve</button></form><form asp-action="RejectCompany" method="post"><input type="hidden" name="id" value="@company.CompanyId" />@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-x-lg me-1"></i>Reject</button></form></div></td></tr>
            }
            </tbody></table></div>
        }
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon"><i class="bi bi-people"></i></span><div class="text-secondary small mt-3">Customers</div><div class="fs-2 fw-bold">@Model.CustomerCount</div></div></div>
        <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon"><i class="bi bi-building"></i></span><div class="text-secondary small mt-3">Companies</div><div class="fs-2 fw-bold">@Model.CompanyCount</div></div></div>
        <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon"><i class="bi bi-shield-check"></i></span><div class="text-secondary small mt-3">Products</div><div class="fs-2 fw-bold">@Model.ProductCount</div></div></div>
        <div class="col-6 col-xl-3"><div class="stat-card"><span class="stat-icon"><i class="bi bi-grid"></i></span><div class="text-secondary small mt-3">Insurance types</div><div class="fs-2 fw-bold">@Model.InsuranceTypeCount</div></div></div>
    </div>

    <div class="dashboard-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div><h2 class="h4 mb-1">Recent products</h2><p class="text-secondary mb-0">Latest insurance products stored in the system.</p></div>
            <a class="btn btn-outline-dark btn-sm" asp-controller="InsuranceProduct" asp-action="Index">View all <i class="bi bi-arrow-up-right ms-1"></i></a>
        </div>
        @if (Model.RecentProducts.Count == 0)
        {
            <div class="text-center text-secondary py-5"><i class="bi bi-inbox fs-1 d-block mb-2"></i>No products have been added yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Product</th><th>Company</th><th>Type</th><th>Premium</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var product in Model.RecentProducts)
                    {
                        <tr><td class="fw-semibold">@product.Name</td><td>@product.Company?.Name</td><td>@product.InsuranceType?.Name</td><td>@product.BasePremium.ToString("C")</td><td><span class="badge text-bg-success">@product.Status</span></td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
